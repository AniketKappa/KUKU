# Copy this file to .env and fill in ONE key. The .env file is never committed.

# Google Gemini. Has a free tier: https://aistudio.google.com/apikey
# On the free tier, Google may use your content to improve its products,
# so don't send real people's cases through it.
GEMINI_API_KEY=

# xAI Grok. Prepaid, no free API tier: https://console.x.ai
# XAI_API_KEY=

# Anthropic Claude: https://console.anthropic.com
# ANTHROPIC_API_KEY=

# DeepSeek. Prepaid and very cheap: https://platform.deepseek.com
# DEEPSEEK_API_KEY=

# Optional. If you set more than one key, choose with: anthropic, gemini, xai or deepseek
# LLM_PROVIDER=gemini
# LAWYER_MODEL=gemini-3.8-flash
# LAWYER_EFFORT=medium
